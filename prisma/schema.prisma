// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A single booked dumpster. One row = one unit of one size reserved for a
// date range. Availability is enforced in lib/availability.ts by counting
// overlapping active bookings for a size against DUMPSTER_SIZES[].units
// (see lib/pricing.ts) — there is no separate inventory table.
model Booking {
  id                 String   @id @default(cuid())
  confirmationNumber String   @unique

  sizeId     String
  startDate  DateTime
  endDate    DateTime
  rentalDays Int
  price      Float

  // Pending -> just booked, awaiting delivery. Confirmed -> business has
  // confirmed delivery details. Completed -> rental finished, unit picked
  // up. Cancelled -> no longer holds the inventory slot.
  status String @default("Pending")

  // Which physical dumpster (of that size) this order is assigned to — e.g.
  // 3 for the "12-Yard #3" unit the owner has physically labeled. Set
  // manually by the owner from admin, not at booking time; null until
  // assigned. Uniqueness among active bookings/orders of the same size is
  // enforced in application code (lib/availability.ts), not the database,
  // since it must also account for CommercialOrder's numbers in the same
  // shared pool.
  unitNumber Int?

  fullName String
  email    String
  phone    String
  street   String
  city     String
  state    String
  zip      String

  pinLat Float?
  pinLng Float?

  cardBrand String?
  cardLast4 String?

  // The Stripe PaymentIntent that actually paid for this booking. @unique so
  // the same successful payment can never be used to create a second
  // booking (e.g. a resubmitted form). Null only for bookings created before
  // Stripe was wired up.
  stripePaymentIntentId String? @unique

  // Set together when a valid promo code was applied at checkout; both are
  // null on a booking made without one. discountAmount is recorded (not just
  // recomputed) so past bookings still show what was actually taken off even
  // after the code that earned it is deactivated or deleted.
  promoCode      String?
  discountAmount Float?

  // Delivery lifecycle, set by the admin from the bookings dashboard. Each
  // timestamp doubles as "has this stage's notification email been sent" —
  // non-null means yes. Independent of `status` above (which is the
  // booking's administrative state, not the physical dumpster's).
  deliveredAt    DateTime?
  pickedUpAt     DateTime?
  thankYouSentAt DateTime?

  // Set by the daily pickup-reminder cron (see app/api/cron/pickup-reminders)
  // once it's emailed/texted the owner that this rental's end date has
  // arrived and it's ready to be picked up. Non-null means "already
  // notified" so the reminder only fires once per booking.
  pickupReminderSentAt DateTime?

  // Money owed beyond what was already charged at checkout — e.g. overage
  // fees (extra tons, extra days, tires) discovered at pickup. Tracked and
  // marked paid manually by the admin; not tied to another Stripe charge.
  outstandingBalance Float   @default(0)
  outstandingNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sizeId, startDate, endDate])
}

// A commercial account — the ONGOING AGREEMENT itself, not a reservation.
// No size, dates, or rate live here; a business signs up once (contract +
// Net 30 credit terms), then places individual CommercialOrders under this
// account over time, each at $50 off the residential rate. The deal is
// contingent on averaging 3+ orders per month — the site doesn't enforce
// that automatically; the owner reviews order counts per account in admin
// and manually charges the price difference (via a CommercialOrder's
// outstandingBalance) for any month that falls short.
model CommercialAccount {
  id            String   @id @default(cuid())
  accountNumber String   @unique

  // Active -> can place orders. Cancelled -> no longer a commercial account.
  status String @default("Active")

  businessName String
  contactName  String
  email        String
  phone        String
  street       String
  city         String
  state        String
  zip          String

  signature String
  agreedAt  DateTime @default(now())

  orders CommercialOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A single dumpster order placed under a CommercialAccount — the commercial
// equivalent of residential's Booking. Counted against the SAME
// DUMPSTER_SIZES inventory pool as residential (see lib/availability.ts), so
// a unit out on a commercial order can't also be double-booked
// residentially. No Stripe payment — billed on credit (Net 30) outside the
// site; outstandingBalance also doubles as where the owner records the
// "didn't hit 3 orders this month" full-price penalty.
model CommercialOrder {
  id                 String   @id @default(cuid())
  confirmationNumber String   @unique

  commercialAccountId String
  commercialAccount   CommercialAccount @relation(fields: [commercialAccountId], references: [id])

  sizeId     String
  startDate  DateTime
  endDate    DateTime
  rentalDays Int
  price      Float

  // Pending -> just ordered. Confirmed -> delivery details confirmed.
  // Completed -> picked up. Cancelled -> no longer holds the slot.
  status String @default("Pending")

  // Which physical dumpster (of that size) this order is assigned to — see
  // the matching field on Booking for the full explanation. Shares the same
  // per-size numbering pool as Booking.unitNumber.
  unitNumber Int?

  street String
  city   String
  state  String
  zip    String

  outstandingBalance Float   @default(0)
  outstandingNote    String?

  // Set when this order was last included in a manually-sent invoice email
  // (see /api/admin/commercial/[id]/invoice) — null means never invoiced.
  // Doesn't mean paid, just "billed" — Net 30 payment itself happens outside
  // the site, so there's nothing further to track here.
  invoicedAt DateTime?

  // See Booking.pickupReminderSentAt — same purpose, same cron.
  pickupReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sizeId, startDate, endDate])
  @@index([commercialAccountId, startDate])
}

// A question/message submitted through the public "Contact Us" form.
// Optionally references a booking's confirmation number so the owner knows
// which order it's about.
model ContactMessage {
  id                 String   @id @default(cuid())
  name               String
  email              String
  phone              String?
  confirmationNumber String?
  message            String

  // New -> just submitted. Read -> owner has seen it. Resolved -> handled.
  status String @default("New")

  createdAt DateTime @default(now())
}

// A discount code the owner posts on social media. Meant to be short-lived —
// twice a week the owner creates a new one and deactivates the old one from
// /admin/promo-codes. `active` is the switch used for that; `expiresAt` is an
// optional belt-and-suspenders auto-expiry so a forgotten code doesn't stay
// valid forever.
model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int      @default(15)
  active          Boolean  @default(true)
  expiresAt       DateTime?
  timesUsed       Int      @default(0)
  createdAt       DateTime @default(now())
}
