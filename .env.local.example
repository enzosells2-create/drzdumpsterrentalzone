# Copy this file to .env.local and fill in your real keys.
# .env.local is already gitignored, so your keys stay out of source control.

# Postgres connection string (Neon, Vercel Postgres, or Supabase all have
# free tiers) — used for both local dev and production, so they can share
# the same database, or you can create a second one for local testing.
# After setting this, run `npx prisma migrate deploy` once to create the
# tables. See prisma/schema.prisma.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Password for the /admin bookings dashboard (shows every booking, who
# made it, and lets you change its status). Pick a real password before
# deploying — this gate is basic (a single shared password), appropriate
# for a small internal tool, not a substitute for real user accounts.
ADMIN_PASSWORD=

# Google Maps JavaScript API key (used on the Drop Location step).
# Enable "Maps JavaScript API" and "Geocoding API" for this key in the
# Google Cloud Console: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe publishable key (used on the Payment step, safe to expose client-side).
# Use the pk_test_... key while developing, pk_live_... once you're ready to
# accept real payments. Must be the SAME mode as STRIPE_SECRET_KEY below —
# Stripe rejects mixing a live key with a test key.
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe SECRET key — server-side only, NEVER expose this to the browser or
# commit it to git. Used to create/confirm PaymentIntents. sk_test_... for
# development, sk_live_... for real charges (must match the publishable
# key's mode above).
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Resend API key — sends the delivery/pickup/thank-you emails to customers
# and new-booking/new-message alerts to the owner. Sign up free at
# https://resend.com, then Settings -> API Keys.
# Until you verify your own domain in Resend, it only allows sending FROM
# onboarding@resend.dev and only TO the email address you signed up with —
# fine for testing, but verify a domain before relying on this for real
# customers. https://resend.com/domains
RESEND_API_KEY=

# The "from" address on outgoing emails. Leave unset to use Resend's shared
# onboarding@resend.dev address (works before you verify a domain, but looks
# less professional). Once a domain is verified in Resend, set this to
# something like: DRZ Dumpster Rental <notifications@drzdumpsterentalzone.com>
RESEND_FROM_EMAIL=

# Where the owner's own alerts (new booking, new contact message) are sent.
# Defaults to drzdumpsterrentalzone@gmail.com if unset.
OWNER_NOTIFICATION_EMAIL=
